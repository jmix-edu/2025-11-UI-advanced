<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://company.com/schema/app-ui-components"
      title="msg://uiAsyncTasksView.title">

    <layout width="100%" height="100%">
        <!-- cardsGrid – CSS grid, 2 колонки за счёт columnMinWidth -->
        <gridLayout id="cardsGrid"
                    width="100%"
                    height="100%"
                    gap="var(--lumo-space-m)"
                    columnMinWidth="40em"
                    classNames="cards-grid">
            <!-- Карточка 1 -->
            <vbox id="card1"
                  classNames="card">
                <button id="performWithoutResultBtn" text="Perform without result"/>
            </vbox>

            <!-- Остальные карточки – пустые -->
            <vbox id="card2"
                  classNames="card">
                <textField id="inputField" clearButtonVisible="true"/>
                <button id="performChangesBtn" text="Perform with result"/>

            </vbox>

            <vbox id="card3"
                  classNames="card"/>

            <vbox id="card4"
                  classNames="card"/>
        </gridLayout>
    </layout>
</view>