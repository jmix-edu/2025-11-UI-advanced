<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://myTimeEntryListView.title">
    <data>
        <collection id="timeEntriesDc" class="com.company.timesheets.entity.TimeEntry">
            <loader id="timeEntriesDl">
                <query>
                    <![CDATA[select e from ts_TimeEntry e
                     where e.user.id = :current_user_id]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
        <timer id="timer" delay="1000" autostart="true" repeating="true"/>
        <settings auto="true"/>
    </facets>

    <layout>

        <!-- Фильтры -->
        <hbox id="filtersBox"
              alignItems="END"
              classNames="flex-wrap gap-m">

            <propertyFilter id="taskFilter"
                            property="task"
                            operation="EQUAL"
                            dataLoader="timeEntriesDl"/>

            <propertyFilter id="statusFilter"
                            property="status"
                            operation="EQUAL"
                            dataLoader="timeEntriesDl"/>

            <!-- Кнопка быстрой очистки всех фильтров -->
            <button id="clearFiltersBtn"
                    text="Очистить фильтры"/>
        </hbox>

        <!-- Панель кнопок -->
        <hbox id="buttonsPanel"
              classNames="buttons-panel"
              alignItems="CENTER"
              justifyContent="BETWEEN">

            <hbox classNames="gap-s">
                <button id="createButton" action="timeEntriesDataGrid.create"/>
                <button id="editButton" action="timeEntriesDataGrid.edit"/>
                <button id="removeButton" action="timeEntriesDataGrid.remove"/>
                <button id="copyButton" action="timeEntriesDataGrid.copy"/>
            </hbox>

            <simplePagination id="pagination" dataLoader="timeEntriesDl"/>
        </hbox>

        <!-- Таблица -->
        <dataGrid id="timeEntriesDataGrid"
                  dataContainer="timeEntriesDc"
                  width="100%"
                  columnReorderingAllowed="true">
            <actions showInContextMenuEnabled="true">
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
                <action id="copy" type="list_timeEntry_copy">
                    <properties>
                        <property name="ownTimeEntry" value="true"/>
                    </properties>
                </action>
            </actions>
            <columns resizable="true">
                <column property="date" autoWidth="true" flexGrow="0"/>
                <column property="task"/>
                <column property="spentTime" autoWidth="true" flexGrow="0"/>
                <column property="status" autoWidth="true" flexGrow="0"/>
                <column property="description" flexGrow="2" editable="true"/>
                <column property="rejectionReason" flexGrow="2"/>

                <!-- Колонка с кнопками редактора в самом конце -->
                <editorActionsColumn>
                    <editButton icon="PENCIL"/>
                    <closeButton icon="CLOSE"/>
                </editorActionsColumn>
            </columns>
        </dataGrid>
    </layout>
</view>